# ==============================================================================
# RECIPIENT CONFIGURATION (required for each deployment)
# ==============================================================================
# Each domain deployment should have its own recipient configuration
# Example: happybirthday1.com uses recipient1, happybirthday2.com uses recipient2

# Unique identifier for this birthday recipient (used to isolate data in database)
# Examples: "recipient1", "recipient2", "sarah-2025", "michael-birthday"
RECIPIENT_ID=recipient1

# Display name shown in the UI (e.g., "Birthday wishes for Sarah")
RECIPIENT_NAME="Sarah"

# ==============================================================================
# AUTHENTICATION
# ==============================================================================

# Access code for contributors to submit notes (password protection)
ACCESS_CODE=birthday2024

# Admin password to view all notes and access admin panel
ADMIN_PASSWORD=admin123

# Cloud printing service URL for PDF generation (full endpoint URL including /api/print)
# The service should accept POST requests and return PDF binary data directly
CLOUD_PRINT_SERVICE_URL="https://your-cloud-print-service.com/api/print"

# Cloud printing service authentication
CLOUD_PRINT_API_KEY="your-api-key-here"
CLOUD_PRINT_API_SECRET="your-api-secret-here"

# ==============================================================================
# DEVELOPMENT STORAGE (used when NODE_ENV=development)
# ==============================================================================
# Create separate "dev" database and blob store in Vercel Dashboard
# This keeps your development work isolated from production data

# Development Postgres - From Vercel Dashboard → Storage → Create Database (dev)
POSTGRES_URL_DEV="postgres://..."

# Development Blob - From Vercel Dashboard → Storage → Create Blob Store (dev)
# Note: Vercel may use either naming convention depending on when it was created
BLOB_READ_WRITE_TOKEN_DEV="vercel_blob_..."
# OR (newer Vercel convention):
BLOB_DEV_READ_WRITE_TOKEN="vercel_blob_..."

# Development Cloud Print - Local development server (optional)
# If not set, falls back to CLOUD_PRINT_SERVICE_URL
CLOUD_PRINT_SERVICE_URL_DEV="http://localhost:8080/api/print"

# ==============================================================================
# PRODUCTION STORAGE (auto-injected by Vercel in production)
# ==============================================================================
# These are automatically added when you connect storage in Vercel Dashboard
# You don't need to set these manually in production - Vercel handles it
# For local testing of "production mode", you can set these to your prod instances

# Production Postgres - Auto-injected by Vercel (or set manually for local prod testing)
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# Production Blob - Auto-injected by Vercel (or set manually for local prod testing)
# Note: Vercel may use either naming convention depending on when it was created
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
# OR (newer Vercel convention):
BLOB_PROD_READ_WRITE_TOKEN="vercel_blob_..."

# ==============================================================================
# RATE LIMITING (optional - recommended for production)
# ==============================================================================
# Uses in-memory rate limiting by default (works in development)
# For production, use Upstash Redis for reliable, distributed rate limiting
#
# Setup instructions:
# 1. Create free account at https://upstash.com/
# 2. Create a Redis database (free tier: 10K requests/day)
# 3. Copy the REST API credentials below
# 4. In Vercel Dashboard → Settings → Environment Variables, add both variables
#
# If these are not set, the app falls back to in-memory rate limiting
# (works but resets on serverless cold starts)

# Upstash Redis REST URL - From Upstash Console → Database → REST API
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"

# Upstash Redis REST Token - From Upstash Console → Database → REST API
UPSTASH_REDIS_REST_TOKEN="your-token-here"
