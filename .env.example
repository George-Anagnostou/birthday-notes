# Access code for contributors to submit notes
ACCESS_CODE=birthday2024

# Admin password to view all notes and access admin panel
ADMIN_PASSWORD=admin123

# Birthday person's name
BIRTHDAY_NAME="Your Friend"

# Vercel Postgres - Get these from Vercel Dashboard after connecting Postgres
# Or run: vercel env pull .env.local
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# Vercel Blob - Get this from Vercel Dashboard after connecting Blob Storage
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
